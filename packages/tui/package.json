{
  "name": "@aragon-agent/tui",
  "version": "0.0.4",
  "description": "AragonAgent terminal runtime — Ink components, terminal I/O protocols, and the view model plus pure domain helpers (config schema, patch parsing, semver) shared with the aragon CLI. Internal package: subpaths are not a stable public API.",
  "license": "MIT",
  "author": "AragonAgent contributors",
  "keywords": [
    "agent",
    "ai-agent",
    "tui",
    "terminal",
    "ink",
    "aragonagent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xdrshjr/AragonAgent.git",
    "directory": "packages/tui"
  },
  "homepage": "https://github.com/xdrshjr/AragonAgent#readme",
  "bugs": {
    "url": "https://github.com/xdrshjr/AragonAgent/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@aragon-agent/core": "^0.2.63",
    "chalk": "^5.6.2",
    "cli-highlight": "^2.0.0",
    "ink-spinner": "^5.0.0",
    "string-width": "^7.2.0",
    "strip-ansi": "^7.1.0",
    "tinyglobby": "^0.2.17"
  },
  "peerDependencies": {
    "ink": "^5.0.1",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "ink": "^5.0.1",
    "ink-testing-library": "^4.0.0",
    "react": "^18.3.1",
    "typescript": "^5.9.3",
    "vitest": "4.1.9"
  }
}
