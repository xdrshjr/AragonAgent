{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "tsBuildInfoFile": "./.tsbuildinfo",
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": ["src/main/**/*.ts", "src/host/**/*.ts", "src/shared/**/*.ts", "src/preload/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/__tests__/**"]
}
