{
  "name": "@aragon-agent/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "AragonAgent Desktop - the Electron front end for the aragon engine. Never published: it ships as an installer, not as an npm package.",
  "license": "MIT",
  "author": "AragonAgent contributors",
  "type": "module",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prebuild": "node scripts/ensure-tui-dist.mjs",
    "build": "node scripts/build.mjs",
    "predev": "node scripts/ensure-tui-dist.mjs",
    "dev": "node scripts/dev.mjs",
    "pretypecheck": "node scripts/ensure-tui-dist.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "pretest": "node scripts/ensure-tui-dist.mjs",
    "test": "vitest run",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "test:e2e:repeat": "node scripts/e2e-repeat.mjs",
    "bench": "node scripts/bench.mjs",
    "bench:verdict": "node scripts/bench-verdict.mjs",
    "update-manifest": "node scripts/make-update-manifest.mjs",
    "ci": "node scripts/ci-desktop.mjs",
    "stage": "node scripts/stage.mjs",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "dist": "node scripts/dist.mjs",
    "pack:win": "powershell -NoProfile -ExecutionPolicy Bypass -File ./pack-desktop.ps1",
    "dist:e2e": "node scripts/dist.mjs --flavor=e2e --dir",
    "start": "electron ."
  },
  "dependencies": {
    "@aragon-agent/cli": "^0.6.51",
    "@aragon-agent/core": "^0.2.63",
    "@aragon-agent/tui": "^0.0.4",
    "fflate": "^0.8.3",
    "tinyglobby": "^0.2.15"
  },
  "devDependencies": {
    "@electron/fuses": "1.8.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/pngjs": "6.0.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "4.14.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron": "45.1.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "jsdom": "^26.1.0",
    "lucide-react": "^0.552.0",
    "pixelmatch": "7.1.0",
    "playwright-core": "1.64.1",
    "pngjs": "7.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.9.3",
    "vite": "8.0.16",
    "vitest": "4.1.9",
    "zustand": "^5.0.8"
  }
}
