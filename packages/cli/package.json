{
  "name": "@argon-agent/cli",
  "version": "0.4.1",
  "description": "ArgonAgent CLI — a Claude-Code / Codex-style interactive terminal UI (TUI) on top of the @argon-agent/core engine. Installable and runnable via npm / npx.",
  "license": "MIT",
  "author": "ArgonAgent contributors",
  "keywords": [
    "agent",
    "ai-agent",
    "llm",
    "cli",
    "tui",
    "terminal",
    "ink",
    "anthropic",
    "openai",
    "google",
    "argonagent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xdrshjr/ArgonAgent.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/xdrshjr/ArgonAgent#readme",
  "bugs": {
    "url": "https://github.com/xdrshjr/ArgonAgent/issues"
  },
  "type": "module",
  "bin": {
    "aragon": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/prepend-shebang.mjs",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@argon-agent/core": "^0.1.1",
    "chalk": "^5.6.2",
    "cli-highlight": "^2.0.0",
    "commander": "^12.1.0",
    "dotenv": "^16.6.1",
    "env-paths": "^3.0.0",
    "ink": "^5.0.1",
    "ink-select-input": "^6.0.0",
    "ink-spinner": "^5.0.0",
    "react": "^18.3.1",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
