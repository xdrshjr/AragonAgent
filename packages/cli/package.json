{
  "name": "@aragon-agent/cli",
  "version": "0.6.16",
  "description": "AragonAgent CLI — a Claude-Code / Codex-style interactive terminal UI (TUI) on top of the @aragon-agent/core engine. Installable and runnable via npm / npx.",
  "license": "MIT",
  "author": "AragonAgent contributors",
  "keywords": [
    "agent",
    "ai-agent",
    "llm",
    "cli",
    "tui",
    "terminal",
    "ink",
    "anthropic",
    "openai",
    "google",
    "aragonagent",
    "exec",
    "headless",
    "automation",
    "ci"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xdrshjr/AragonAgent.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/xdrshjr/AragonAgent#readme",
  "bugs": {
    "url": "https://github.com/xdrshjr/AragonAgent/issues"
  },
  "type": "module",
  "bin": {
    "aragon": "./dist/launcher.js"
  },
  "files": [
    "dist",
    "runtime",
    "skills",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node scripts/prepend-shebang.mjs",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@aragon-agent/core": "^0.2.28",
    "chalk": "^5.6.2",
    "cli-highlight": "^2.0.0",
    "commander": "^12.1.0",
    "dotenv": "^16.6.1",
    "env-paths": "^3.0.0",
    "fflate": "^0.8.3",
    "ink": "^5.0.1",
    "ink-select-input": "^6.0.0",
    "ink-spinner": "^5.0.0",
    "react": "^18.3.1",
    "string-width": "^7.2.0",
    "strip-ansi": "^7.1.0",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
